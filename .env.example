# Banco de dados (uv run fora do Docker aponta para localhost; dentro do
# docker-compose, o serviço "app" aponta para o host interno "db" — o
# docker-compose.yml sobrescreve DATABASE_URL do serviço "app" usando as
# variáveis POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB abaixo, que também
# configuram o serviço "db" do Postgres)
DATABASE_URL=postgresql+asyncpg://lupa:senha@localhost:5432/lupa_diarios
POSTGRES_USER=lupa
POSTGRES_PASSWORD=senha
POSTGRES_DB=lupa_diarios

# Agendamento (cron: a cada hora, 8h-20h, seg-sex, horário de Brasília)
SCAN_CRON="0 8-20 * * 1-5"
TZ=America/Sao_Paulo

# SMTP (MailGrid — preencha com seus dados)
SMTP_HOST=smtp.mailgrid.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM="Lupa Diários <diarios@seudominio.com.br>"
MAIL_TO=seu-email@exemplo.com

# Anexos
MAX_ATTACH_MB=15   # soma dos anexos; acima disso, vai só o link

# Retenção do buffer de publications (dias)
RETENTION_DAYS=3

# Reservado para integração futura com o SaaS Lupa (Django) via JWT.
# Não usado no MVP.
JWT_SECRET=