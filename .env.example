# Agendamento (cron: a cada hora, 8h-20h, seg-sex, horário de Brasília)
SCAN_CRON="0 8-20 * * 1-5"
TZ=America/Sao_Paulo

# SMTP (MailGrid — preencha com seus dados)
SMTP_HOST=smtp.mailgrid.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM="Lupa Diários <diarios@seudominio.com.br>"
MAIL_TO=seu-email@exemplo.com

# Anexos
MAX_ATTACH_MB=15   # soma dos anexos; acima disso, vai só o link